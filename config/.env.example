# Exam Pipeline Environment Variables
# Copy this file to .env and fill in your actual credentials

# OpenAI API
OPENAI_API_KEY=sk-proj-your-key-here

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json
GCS_BUCKET_NAME=your-bucket-name

# App Store Connect (for deployment)
APP_STORE_CONNECT_KEY_ID=your-key-id
APP_STORE_CONNECT_ISSUER_ID=your-issuer-id
APP_STORE_CONNECT_KEY_PATH=/path/to/AuthKey_XXXXX.p8

# Fastlane (Apple ID app-specific password)
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=your-app-specific-password

# Google Blogger (for privacy policy posting - optional)
GOOGLE_BLOGGER_CLIENT_SECRET=/path/to/client_secret.json
GOOGLE_BLOGGER_BLOG_ID=your-blog-id
